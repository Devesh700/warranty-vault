# WarrantyVault Environment Secrets (DO NOT COMMIT .env)
# Copy this file to .env and fill in your Firebase & RevenueCat keys.

# Firebase Web / Shared Configuration
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MEASUREMENT_ID=
# Optional Web Push certificate key pair (VAPID public key) for Firebase Cloud Messaging on Web
FIREBASE_VAPID_KEY=

# Optional platform-specific Firebase App IDs (if different from Web App ID)
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=

# RevenueCat API Keys
RC_ANDROID_KEY=
RC_IOS_KEY=
